# ==============================================================================
# SANKARA FELLOWSHIP EXAM SYSTEM — DOCKER ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Port on Host (Access via http://YOUR_SERVER_IP:3002)
APP_PORT=3002

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# OPTION 1: Use the built-in isolated PostgreSQL Docker container (Default)
# Leave DATABASE_URL commented out. The container fellowship-db will be used.
POSTGRES_DB=fellowship_db
POSTGRES_USER=fellowship_admin
POSTGRES_PASSWORD=FellowshipSecure2026!
HOST_DB_PORT=5433

# OPTION 2: Connect to an existing old PostgreSQL database on the server
# If uncommented, the application will connect directly to this database,
# automatically run the complete rework/migration on startup, and update all schemas.
# Example for host Postgres: postgresql://postgres:password@host.docker.internal:5432/my_old_db
# DATABASE_URL=postgresql://fellowship_admin:FellowshipSecure2026!@fellowship-db:5432/fellowship_db

# JWT & Session Secret Key (Replace with a random 64-char string in production)
SESSION_SECRET=a8f5c9e2b4d7f1a3c6e9d2b5f8a1c4e7d0b3f6a9c2e5d8b1f4a7c0e3d6b9f2a5

# Email / SMTP Configuration (Optional - can also be configured via Admin UI)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=admissions@sankaraeye.com
SMTP_PASS=your_app_password_here
SMTP_FROM=admissions@sankaraeye.com

# Razorpay Payment Gateway (Optional - for application fee collection)
RAZORPAY_KEY_ID=rzp_live_ddDz3Yp0860GqG

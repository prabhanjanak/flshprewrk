# PostgreSQL Database Credentials for Container
POSTGRES_DB=fellowship_db
POSTGRES_USER=fellowship_admin
POSTGRES_PASSWORD=FellowshipSecure2026!

# Database Port on Host (Maps to 5433 to prevent conflict with local Postgres on 5432)
